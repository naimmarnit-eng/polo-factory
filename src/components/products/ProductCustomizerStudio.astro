  // FREE DRAG & DROP POINTER EVENTS ENGINE
  let isDragging = false;
  let startX = 0;
  let startY = 0;
  let initialTopPct = 32;
  let initialLeftPct = 50;

  if (designContainer && stageWrapper) {
    designContainer.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.button !== 0) return;
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;

      const styleTop = designContainer.style.top;
      const styleLeft = designContainer.style.left;
      initialTopPct = parseFloat(styleTop) || 32;
      initialLeftPct = parseFloat(styleLeft) || 50;

      designContainer.setPointerCapture(e.pointerId);
      designContainer.style.cursor = 'grabbing';
      e.preventDefault();
    });

    designContainer.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isDragging) return;
      const rect = stageWrapper.getBoundingClientRect();
      const deltaX = e.clientX - startX;
      const deltaY = e.clientY - startY;

      const deltaPctX = (deltaX / rect.width) * 100;
      const deltaPctY = (deltaY / rect.height) * 100;

      let newLeft = initialLeftPct + deltaPctX;
      let newTop = initialTopPct + deltaPctY;

      newLeft = Math.max(25, Math.min(75, newLeft));
      newTop = Math.max(20, Math.min(80, newTop));

      designContainer.style.left = `${newLeft}%`;
      designContainer.style.top = `${newTop}%`;
    });

    const stopDrag = (e: PointerEvent) => {
      if (isDragging) {
        isDragging = false;
        designContainer.style.cursor = 'grab';
        try {
          designContainer.releasePointerCapture(e.pointerId);
        } catch (_) {}
      }
    };

    designContainer.addEventListener('pointerup', stopDrag);
    designContainer.addEventListener('pointercancel', stopDrag);
  }


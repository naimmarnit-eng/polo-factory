  function renderGarmentVector() {
    const tpl = CATALOG[currentProduct];
    if (confProductTitle) confProductTitle.textContent = tpl.title;

    if (!tpl.hasSleeves) {
      sleeveToggleGroup?.classList.add('hidden');
      badgeSleeveInd?.classList.add('hidden');
    } else {
      sleeveToggleGroup?.classList.remove('hidden');
      badgeSleeveInd?.classList.remove('hidden');
    }

    const bodyD = currentView === 'front' ? tpl.bodyFront : tpl.bodyBack;
    const collarD = currentView === 'front' ? tpl.collarFront : tpl.collarBack;
    const detailsHtml = currentView === 'front' ? tpl.detailsFront : tpl.detailsBack;

    let sleeveLD = '';
    let sleeveRD = '';

    if (tpl.hasSleeves) {
      if (currentView === 'front') {
        sleeveLD = currentSleeve === 'short' ? tpl.sleeveLFrontShort : tpl.sleeveLFrontLong;
        sleeveRD = currentSleeve === 'short' ? tpl.sleeveRFrontShort : tpl.sleeveRFrontLong;
      } else {
        sleeveLD = currentSleeve === 'short' ? tpl.sleeveLBackShort : tpl.sleeveLBackLong;
        sleeveRD = currentSleeve === 'short' ? tpl.sleeveRBackShort : tpl.sleeveRBackLong;
      }
    }

    if (svgBody) {
      svgBody.setAttribute('d', bodyD);
      svgBodyOverlay.setAttribute('d', bodyD);
      svgBody.setAttribute('fill', garmentColor);
    }

    if (tpl.hasSleeves && svgSleeveL && svgSleeveR) {
      svgSleeveL.setAttribute('d', sleeveLD);
      svgSleeveLOverlay.setAttribute('d', sleeveLD);
      svgSleeveL.setAttribute('fill', garmentColor);
      svgSleeveL.classList.remove('hidden');

      svgSleeveR.setAttribute('d', sleeveRD);
      svgSleeveROverlay.setAttribute('d', sleeveRD);
      svgSleeveR.setAttribute('fill', garmentColor);
      svgSleeveR.classList.remove('hidden');
    } else if (svgSleeveL && svgSleeveR) {
      svgSleeveL.classList.add('hidden');
      svgSleeveR.classList.add('hidden');
    }

    if (svgCollar) svgCollar.setAttribute('d', collarD);
    if (svgDetails) svgDetails.innerHTML = detailsHtml;

    if (svgBacktape) {
      if (currentView === 'back' && tpl.hasSleeves) {
        svgBacktape.classList.remove('hidden');
      } else {
        svgBacktape.classList.add('hidden');
      }
    }

    if (badgeViewInd) badgeViewInd.textContent = `${currentView.toUpperCase()} VIEW`;
    if (badgeSleeveInd) badgeSleeveInd.textContent = tpl.hasSleeves ? `${currentSleeve.toUpperCase()} SLEEVE` : 'NO SLEEVES';
  }


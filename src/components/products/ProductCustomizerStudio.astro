---
// ProductCustomizerStudio.astro
// Interactive 2D Vector Apparel & Product Customizer Visualizer Studio
---

<section id="customizer-studio" class="mb-16 relative z-20">
  <!-- Studio Dual Column Layout Container -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-7xl mx-auto">
    
    <!-- LEFT COLUMN: Visualizer Stage (Span 7) -->
    <div class="lg:col-span-7 space-y-4">
      
      <!-- Stage Wrapper Card -->
      <div class="bg-white rounded-3xl border border-gray-200/90 shadow-xl p-4 sm:p-6 relative overflow-hidden flex flex-col items-center">
        
        <!-- Top Floating Controls Bar -->
        <div class="w-full flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b border-gray-150 text-xs font-bold">
          
          <!-- Product Catalog Selector -->
          <div class="flex items-center gap-2">
            <label for="catalog-select" class="text-gray-500 font-bold hidden sm:inline">ประเภทสินค้า:</label>
            <select
              id="catalog-select"
              class="bg-gray-100 border border-gray-300 rounded-xl px-3 py-1.5 font-extrabold text-gray-800 text-xs cursor-pointer focus:ring-2 focus:ring-[#FF5A1F] focus:outline-none"
            >
              <option value="polo-classic">👔 เสื้อโปโลคลาสสิก (Polo Classic)</option>
              <option value="premium-tshirt">👕 เสื้อยืดพรีเมียม (T-Shirt)</option>
              <option value="sports-mesh">⚽ เสื้อกีฬาผ้าเมช (Sports Mesh)</option>
              <option value="uniform-shirt">👔 เสื้อเชิ้ตยูนิฟอร์ม (Uniform Shirt)</option>
              <option value="hooded-sweat">🧥 เสื้อฮู้ดดี้ (Hoodie)</option>
              <option value="canvas-bag">👜 กระเป๋าผ้าแคนวาส (Canvas Bag)</option>
              <option value="apron-custom">🧑‍🍳 ผ้ากันเปื้อน (Custom Apron)</option>
              <option value="baseball-cap">🧢 หมวกแก๊ป (Baseball Cap)</option>
            </select>
          </div>

          <!-- View Angle & Sleeve Toggles -->
          <div class="flex items-center gap-2">
            <!-- Front / Back Toggle -->
            <div class="inline-flex rounded-xl bg-gray-100 p-1 border border-gray-200" id="view-toggle-group">
              <button
                type="button"
                id="btn-view-front"
                class="px-3 py-1 rounded-lg text-xs font-black transition-all bg-white text-gray-900 shadow-sm border border-gray-200/50 cursor-pointer"
                data-view="front"
              >
                ด้านหน้า
              </button>
              <button
                type="button"
                id="btn-view-back"
                class="px-3 py-1 rounded-lg text-xs font-black transition-all text-gray-500 hover:text-gray-900 cursor-pointer"
                data-view="back"
              >
                ด้านหลัง
              </button>
            </div>

            <!-- Short / Long Sleeve Toggle -->
            <div class="inline-flex rounded-xl bg-gray-100 p-1 border border-gray-200" id="sleeve-toggle-group">
              <button
                type="button"
                id="btn-sleeve-short"
                class="px-2.5 py-1 rounded-lg text-[11px] font-black transition-all bg-white text-gray-900 shadow-sm cursor-pointer"
                data-sleeve="short"
              >
                แขนสั้น
              </button>
              <button
                type="button"
                id="btn-sleeve-long"
                class="px-2.5 py-1 rounded-lg text-[11px] font-black transition-all text-gray-500 hover:text-gray-900 cursor-pointer"
                data-sleeve="long"
              >
                แขนยาว
              </button>
            </div>
          </div>
        </div>

        <!-- Visualizer 2D Stage Canvas Wrapper (600x600 resolution style) -->
        <div
          id="faceless-stage-wrapper"
          class="relative w-full aspect-square max-w-[540px] bg-slate-900/5 rounded-2xl border border-gray-200 overflow-hidden shadow-inner flex items-center justify-center select-none"
        >
          <!-- View Angle Overlay Badge Indicator -->
          <div class="absolute top-3 left-3 z-30 pointer-events-none flex items-center gap-2">
            <span id="badge-view-indicator" class="px-2.5 py-1 bg-black/75 backdrop-blur-md text-white text-[10px] font-black tracking-widest rounded-full uppercase shadow">
              FRONT VIEW
            </span>
            <span id="badge-sleeve-indicator" class="px-2.5 py-1 bg-[#FF5A1F]/90 backdrop-blur-md text-white text-[10px] font-black tracking-widest rounded-full uppercase shadow">
              SHORT SLEEVE
            </span>
          </div>

          <!-- SVG Garment Vector Engine Canvas -->
          <svg
            id="garment-svg-canvas"
            viewBox="0 0 600 600"
            class="w-full h-full object-contain filter drop-shadow-md transition-all duration-300"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <!-- Ambient Body Highlights & 3D Shading Gradients -->
              <linearGradient id="svg-body-shading" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.2" />
                <stop offset="25%" stop-color="#ffffff" stop-opacity="0.05" />
                <stop offset="75%" stop-color="#000000" stop-opacity="0.05" />
                <stop offset="100%" stop-color="#000000" stop-opacity="0.25" />
              </linearGradient>

              <linearGradient id="svg-sleeve-l-shade" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.25" />
                <stop offset="100%" stop-color="#000000" stop-opacity="0.2" />
              </linearGradient>

              <linearGradient id="svg-sleeve-r-shade" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.05" />
                <stop offset="100%" stop-color="#000000" stop-opacity="0.3" />
              </linearGradient>

              <!-- Back Tape Hatch Pattern -->
              <pattern id="svg-backtape-pattern" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="10" stroke="#FF5A1F" stroke-width="3" />
                <line x1="5" y1="0" x2="5" y2="10" stroke="#1E293B" stroke-width="3" />
              </pattern>
            </defs>

            <!-- Drop shadow floor ellipse -->
            <ellipse cx="300" cy="540" rx="160" ry="18" fill="rgba(0,0,0,0.08)" />

            <!-- Garment Vector Group -->
            <g id="svg-garment-group">
              <!-- Left Sleeve Path -->
              <path
                id="svg-garment-sleeve-l"
                d="M 180,180 L 80,240 L 115,310 L 180,270 Z"
                fill="#FF5A1F"
                stroke="#1E293B"
                stroke-width="4"
                stroke-linejoin="round"
              />
              <path id="svg-sleeve-l-overlay" d="M 180,180 L 80,240 L 115,310 L 180,270 Z" fill="url(#svg-sleeve-l-shade)" style="mix-blend-mode: multiply;" />

              <!-- Right Sleeve Path -->
              <path
                id="svg-garment-sleeve-r"
                d="M 420,180 L 520,240 L 485,310 L 420,270 Z"
                fill="#FF5A1F"
                stroke="#1E293B"
                stroke-width="4"
                stroke-linejoin="round"
              />
              <path id="svg-sleeve-r-overlay" d="M 420,180 L 520,240 L 485,310 L 420,270 Z" fill="url(#svg-sleeve-r-shade)" style="mix-blend-mode: multiply;" />

              <!-- Main Body Path -->
              <path
                id="svg-garment-body"
                d="M 180,180 Q 300,195 420,180 L 440,510 L 160,510 Z"
                fill="#FF5A1F"
                stroke="#1E293B"
                stroke-width="4"
                stroke-linejoin="round"
              />
              <path id="svg-body-overlay" d="M 180,180 Q 300,195 420,180 L 440,510 L 160,510 Z" fill="url(#svg-body-shading)" style="mix-blend-mode: multiply;" />

              <!-- Collar / Neck Base Path -->
              <path
                id="svg-garment-collar"
                d="M 230,170 Q 300,220 370,170 Q 300,150 230,170 Z"
                fill="#1E293B"
                stroke="#1E293B"
                stroke-width="3"
              />

              <!-- Back Neck Tape Line (#svg-garment-backtape - visible in Back view) -->
              <path
                id="svg-garment-backtape"
                d="M 235,175 Q 300,190 365,175"
                fill="none"
                stroke="url(#svg-backtape-pattern)"
                stroke-width="6"
                stroke-linecap="round"
                class="hidden"
              />

              <!-- Extra Feature Details (Placket, Buttons, Pocket, Hood, etc) -->
              <g id="svg-garment-details">
                <!-- Placket for Polo -->
                <path id="svg-detail-placket" d="M 285,185 L 315,185 L 315,270 L 285,270 Z" fill="#FFFFFF" stroke="#1E293B" stroke-width="2" />
                <circle id="svg-detail-btn1" cx="300" cy="210" r="4" fill="#1E293B" />
                <circle id="svg-detail-btn2" cx="300" cy="245" r="4" fill="#1E293B" />
              </g>

              <!-- Crease Seam Lines for realism -->
              <path d="M 185,220 Q 210,240 230,230" stroke="black" stroke-width="2" opacity="0.12" fill="none" />
              <path d="M 415,220 Q 390,240 370,230" stroke="black" stroke-width="2" opacity="0.12" fill="none" />
            </g>
          </svg>

          <!-- Printable Area Bounds Overlay Box (#printable-area-bounds) -->
          <div
            id="printable-area-bounds"
            class="absolute inset-0 pointer-events-none border-2 border-dashed border-[#FF5A1F]/40 rounded-2xl m-10"
            style="clip-path: polygon(25% 18%, 75% 18%, 75% 85%, 25% 85%);"
          >
            <span class="absolute top-1 right-2 text-[9px] font-black text-[#FF5A1F]/60 uppercase tracking-widest">
              PRINT BOUNDS
            </span>
          </div>

          <!-- Free Draggable Logo & Custom Text Overlay Container (#placed-design-container) -->
          <div
            id="placed-design-container"
            class="absolute z-20 flex flex-col items-center justify-center p-2 border-2 border-dashed border-transparent hover:border-[#FF5A1F] active:border-[#FF5A1F] rounded-xl cursor-grab select-none transition-shadow group"
            style="top: 32%; left: 50%; transform: translate(-50%, -50%); min-width: 120px; touch-action: none;"
          >
            <!-- Position Indicator Drag Handle Badge -->
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#FF5A1F] text-white text-[9px] font-black px-2 py-0.5 rounded-full opacity-0 group-hover:opacity-100 transition-opacity shadow pointer-events-none whitespace-nowrap">
              ✋ ลากเพื่อย้ายตำแหน่ง
            </div>

            <!-- Uploaded Logo Image (#placed-logo-img) -->
            <img
              id="placed-logo-img"
              src=""
              alt="Custom Logo"
              class="hidden max-h-24 max-w-32 object-contain pointer-events-none transition-transform duration-100"
              style="transform: scale(1);"
            />

            <!-- Live Custom Text Overlay Span (#placed-text-span) -->
            <span
              id="placed-text-span"
              class="font-black text-gray-900 text-center tracking-wide pointer-events-none mt-1 transition-all"
              style="font-family: 'Inter', sans-serif; font-size: 18px; color: #111827;"
            >
              YOUR LOGO / TEXT
            </span>
          </div>

        </div>

        <!-- Text & Logo Customization Toolbar below canvas -->
        <div class="w-full mt-4 pt-4 border-t border-gray-150 grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Custom Text Controls -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label for="custom-text-input" class="text-xs font-black text-gray-700 uppercase tracking-wider">
                ✍️ ข้อความบนเสื้อ (Custom Text):
              </label>
              <button type="button" id="btn-text-color-trigger" class="flex items-center gap-1 text-[11px] font-bold text-gray-600 hover:text-[#FF5A1F] cursor-pointer">
                <span id="text-color-preview-dot" class="w-3.5 h-3.5 rounded-full border border-gray-300 shadow-sm" style="background-color: #111827;"></span>
                <span>สีข้อความ 🎨</span>
              </button>
            </div>
            <input
              type="text"
              id="custom-text-input"
              value="YOUR LOGO / TEXT"
              placeholder="พิมพ์ข้อความที่ต้องการสกรีน/ปัก..."
              class="w-full px-3.5 py-2 text-xs font-bold rounded-xl border border-gray-300 focus:ring-2 focus:ring-[#FF5A1F] focus:outline-none shadow-sm"
            />

            <div class="grid grid-cols-2 gap-2 pt-1">
              <!-- Font Family Dropdown -->
              <div>
                <label for="font-family-select" class="text-[10px] font-bold text-gray-400 block mb-1">ฟอนต์ (Font):</label>
                <select
                  id="font-family-select"
                  class="w-full px-2 py-1.5 text-xs font-bold rounded-lg border border-gray-300 bg-white focus:outline-none cursor-pointer"
                >
                  <option value="Inter, sans-serif">Inter (Modern)</option>
                  <option value="Impact, sans-serif">Impact (Bold)</option>
                  <option value="'Courier New', monospace">Courier (Typewriter)</option>
                  <option value="Georgia, serif">Georgia (Classic)</option>
                  <option value="'Brush Script MT', cursive">Brush Script (Handwriting)</option>
                </select>
              </div>

              <!-- Font Size Slider (10px–28px) -->
              <div>
                <div class="flex justify-between items-center mb-1">
                  <label for="font-size-slider" class="text-[10px] font-bold text-gray-400">ขนาด (Size):</label>
                  <span id="font-size-val" class="text-[10px] font-bold text-gray-700">18px</span>
                </div>
                <input
                  type="range"
                  id="font-size-slider"
                  min="10"
                  max="28"
                  value="18"
                  class="w-full accent-[#FF5A1F] cursor-pointer"
                />
              </div>
            </div>
          </div>

          <!-- Logo Image Dropzone & Scale Controls -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label class="text-xs font-black text-gray-700 uppercase tracking-wider">
                🖼️ อัปโหลดโลโก้ (Upload Logo):
              </label>
              <button type="button" id="btn-remove-logo" class="text-[11px] font-bold text-red-500 hover:underline hidden cursor-pointer">
                ✕ ลบโลโก้
              </button>
            </div>

            <!-- File Upload Dropzone -->
            <label
              for="logo-file-input"
              class="flex flex-col items-center justify-center w-full h-18 border-2 border-dashed border-gray-300 hover:border-[#FF5A1F] rounded-xl bg-gray-50/50 hover:bg-orange-50/30 cursor-pointer transition-colors"
            >
              <div class="flex items-center gap-2 text-xs font-bold text-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#FF5A1F]"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span>คลิกเพื่อเลือกไฟล์รูปโลโก้ (.PNG / .JPG)</span>
              </div>
              <span id="logo-file-name" class="text-[10px] font-semibold text-gray-400 mt-0.5 truncate max-w-[200px]">
                รองรับไฟล์พื้นหลังใส PNG
              </span>
              <input type="file" id="logo-file-input" accept="image/*" class="hidden" />
            </label>

            <!-- Logo Scale Slider (60% to 140%) -->
            <div id="logo-scale-wrapper" class="pt-1 opacity-50 pointer-events-none transition-opacity">
              <div class="flex justify-between items-center mb-1">
                <label for="logo-scale-slider" class="text-[10px] font-bold text-gray-400">ขนาดโลโก้ (Logo Scale):</label>
                <span id="logo-scale-val" class="text-[10px] font-bold text-gray-700">100%</span>
              </div>
              <input
                type="range"
                id="logo-scale-slider"
                min="60"
                max="140"
                value="100"
                class="w-full accent-[#FF5A1F] cursor-pointer"
              />
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- RIGHT COLUMN: Product Configurator Card (Span 5) -->
    <div class="lg:col-span-5 space-y-6">
      
      <div class="bg-white rounded-3xl border border-gray-200/90 shadow-xl p-6 space-y-6">
        
        <!-- Header & Real-time Price Estimate -->
        <div class="pb-4 border-b border-gray-150 flex items-start justify-between gap-4">
          <div>
            <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest block">
              Product Customizer Studio
            </span>
            <h3 id="conf-product-title" class="text-xl font-black text-gray-900 mt-0.5">
              เสื้อโปโลคลาสสิก (Polo Classic)
            </h3>
          </div>
          <div class="text-right">
            <span class="text-xs font-black text-[#06C755] bg-green-50 border border-green-200 px-3 py-1.5 rounded-full inline-block">
              💬 สอบถามราคาทาง LINE
            </span>
          </div>
        </div>

        <!-- 1. Garment Color Swatches & Custom Picker Button -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-gray-700 uppercase tracking-wider">
              🎨 เลือกสีผ้า (Garment Color):
            </span>
            <span id="conf-color-name" class="text-xs font-bold text-[#FF5A1F]">
              Orange (#FF5A1F)
            </span>
          </div>

          <!-- Color Swatches Grid (16 curated colors + Custom Picker button) -->
          <div class="flex flex-wrap gap-2" id="garment-color-swatches">
            <button type="button" data-color="#FFFFFF" data-name="White" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #FFFFFF;" title="White"></button>
            <button type="button" data-color="#111827" data-name="Black" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #111827;" title="Black"></button>
            <button type="button" data-color="#1E3A8A" data-name="Navy" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #1E3A8A;" title="Navy"></button>
            <button type="button" data-color="#DC2626" data-name="Red" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #DC2626;" title="Red"></button>
            <button type="button" data-color="#2563EB" data-name="Blue" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #2563EB;" title="Blue"></button>
            <button type="button" data-color="#059669" data-name="Emerald" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #059669;" title="Emerald"></button>
            <button type="button" data-color="#FF5A1F" data-name="Orange" class="swatch-btn w-8 h-8 rounded-full border-2 border-white ring-2 ring-[#FF5A1F] shadow-sm transition-transform hover:scale-110" style="background-color: #FF5A1F;" title="Orange"></button>
            <button type="button" data-color="#D97706" data-name="Gold" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #D97706;" title="Gold"></button>
            <button type="button" data-color="#7C3AED" data-name="Purple" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #7C3AED;" title="Purple"></button>
            <button type="button" data-color="#EC4899" data-name="Pink" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #EC4899;" title="Pink"></button>
            <button type="button" data-color="#0284C7" data-name="Sky" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #0284C7;" title="Sky"></button>
            <button type="button" data-color="#65A30D" data-name="Lime" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #65A30D;" title="Lime"></button>
            <button type="button" data-color="#374151" data-name="Charcoal" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #374151;" title="Charcoal"></button>
            <button type="button" data-color="#9CA3AF" data-name="Silver" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #9CA3AF;" title="Silver"></button>
            <button type="button" data-color="#FACC15" data-name="Yellow" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #FACC15;" title="Yellow"></button>
            <button type="button" data-color="#FEF3C7" data-name="Cream" class="swatch-btn w-8 h-8 rounded-full border border-gray-300 shadow-sm transition-transform hover:scale-110" style="background-color: #FEF3C7;" title="Cream"></button>
            
            <!-- Custom Color Picker Icon Trigger (🎨) -->
            <button
              type="button"
              id="btn-open-custom-color-modal"
              class="w-8 h-8 rounded-full bg-gradient-to-tr from-pink-500 via-purple-500 to-amber-400 text-white font-black text-xs flex items-center justify-center shadow-md hover:scale-110 transition-transform cursor-pointer"
              title="เลือกสีแบบกำหนดเอง (Custom Color)"
            >
              🎨
            </button>
          </div>
        </div>

        <!-- 2. Wholesale Size & Quantity Selector -->
        <div class="space-y-3">
          <span class="text-xs font-black text-gray-700 uppercase tracking-wider block">
            📐 ขนาดไซซ์ & จำนวนสั่งผลิต (Wholesale Quantities):
          </span>
          
          <!-- Size Selector Buttons (S / M / L / XL / 2XL / 3XL) -->
          <div class="grid grid-cols-6 gap-1.5" id="conf-size-grid">
            <button type="button" data-size="S" class="size-btn py-2 rounded-xl border text-xs font-black transition-all border-gray-200 text-gray-700 hover:border-gray-400 cursor-pointer">S</button>
            <button type="button" data-size="M" class="size-btn py-2 rounded-xl border text-xs font-black transition-all border-gray-200 text-gray-700 hover:border-gray-400 cursor-pointer">M</button>
            <button type="button" data-size="L" class="size-btn py-2 rounded-xl border text-xs font-black transition-all border-gray-900 bg-gray-950 text-white shadow cursor-pointer">L</button>
            <button type="button" data-size="XL" class="size-btn py-2 rounded-xl border text-xs font-black transition-all border-gray-200 text-gray-700 hover:border-gray-400 cursor-pointer">XL</button>
            <button type="button" data-size="2XL" class="size-btn py-2 rounded-xl border text-xs font-black transition-all border-gray-200 text-gray-700 hover:border-gray-400 cursor-pointer">2XL</button>
            <button type="button" data-size="3XL" class="size-btn py-2 rounded-xl border text-xs font-black transition-all border-gray-200 text-gray-700 hover:border-gray-400 cursor-pointer">3XL</button>
          </div>

          <!-- Quantity Stepper (+ / - input, min 100) -->
          <div class="flex items-center justify-between bg-gray-50 p-3 rounded-2xl border border-gray-200">
            <div>

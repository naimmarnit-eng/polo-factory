  async function generateStagePngBlob(): Promise<Blob> {
    const canvas = document.createElement('canvas');
    canvas.width = 600;
    canvas.height = 600;
    const ctx = canvas.getContext('2d')!;

    const svgEl = document.getElementById('garment-svg-canvas') as SVGElement;
    const svgString = new XMLSerializer().serializeToString(svgEl);
    const svgBlob = new Blob([svgString], { type: 'image/svg+xml;charset=utf-8' });
    const URL = window.URL || window.webkitURL || window;
    const svgUrl = URL.createObjectURL(svgBlob);

    const img = new Image();
    await new Promise((resolve, reject) => {
      img.onload = resolve;
      img.onerror = reject;
      img.src = svgUrl;
    });
    ctx.drawImage(img, 0, 0, 600, 600);
    URL.revokeObjectURL(svgUrl);

    if (designContainer && stageWrapper) {
      const stageRect = stageWrapper.getBoundingClientRect();
      const containerRect = designContainer.getBoundingClientRect();
      
      const scaleX = 600 / stageRect.width;
      const scaleY = 600 / stageRect.height;
      
      const posX = (containerRect.left - stageRect.left) * scaleX;
      const posY = (containerRect.top - stageRect.top) * scaleY;
      const containerW = containerRect.width * scaleX;
      const containerH = containerRect.height * scaleY;

      if (hasUploadedLogo && placedLogoImg && placedLogoImg.src) {
        const logoCanvasImg = new Image();
        logoCanvasImg.crossOrigin = 'anonymous';
        await new Promise((resolve) => {
          logoCanvasImg.onload = resolve;
          logoCanvasImg.onerror = resolve;
          logoCanvasImg.src = placedLogoImg.src;
        });

        if (logoCanvasImg.complete && logoCanvasImg.naturalWidth > 0) {
          const scaledW = (containerW * 0.7) * (logoScale / 100);
          const scaledH = (containerH * 0.5) * (logoScale / 100);
          ctx.drawImage(logoCanvasImg, posX + (containerW - scaledW) / 2, posY, scaledW, scaledH);
        }
      }

      if (customText && customText.trim()) {
        const style = window.getComputedStyle(placedTextSpan);
        const fontSizePx = parseFloat(style.fontSize) * scaleY;

        ctx.font = `bold ${fontSizePx}px ${fontStyle}`;
        ctx.fillStyle = textColor;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        
        const textX = posX + containerW / 2;
        const textY = posY + containerH * 0.75;
        ctx.fillText(customText.trim(), textX, textY);
      }
    }

    return new Promise((resolve, reject) => {
      canvas.toBlob((blob) => {
        if (blob) resolve(blob);
        else reject(new Error('Canvas conversion failed'));
      }, 'image/png');
    });
  }

  btnCopyShirtImg?.addEventListener('click', async () => {
    try {
      showToast('กำลังสร้างรูปภาพ...', '⏳');
      const pngBlob = await generateStagePngBlob();
      const text = buildSpecText();

      if (navigator.clipboard && 'write' in navigator.clipboard && typeof ClipboardItem !== 'undefined') {
        const clipboardItem = new ClipboardItem({
          'image/png': pngBlob,
          'text/plain': new Blob([text], { type: 'text/plain' })
        });
        await navigator.clipboard.write([clipboardItem]);
        showToast('คัดลอกรูปภาพและสเปกเสื้อเรียบร้อย!', '🖼️');
      } else {
        await navigator.clipboard.writeText(text);
        const link = document.createElement('a');
        link.download = `custom-garment-spec.png`;
        link.href = URL.createObjectURL(pngBlob);
        link.click();
        showToast('คัดลอกข้อความสเปก & ดาวน์โหลดรูปเสื้อแล้ว!', '🖼️');
      }
    } catch (err) {
      const text = buildSpecText();
      await navigator.clipboard.writeText(text);
      showToast('คัดลอกข้อความสเปกเรียบร้อย!', '📋');
    }
  });

  document.addEventListener('DOMContentLoaded', initStudio);
  document.addEventListener('astro:page-load', initStudio);
</script>

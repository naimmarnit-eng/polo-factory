---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Button } from '@/components/starwind/button';
import fabricCuttingImg from '@/assets/process/process_fabric_cutting.jpg';
import embroideryImg from '@/assets/process/process_embroidery_stitching.jpg';
import sewingImg from '@/assets/process/process_precision_sewing.jpg';
import qcPackagingImg from '@/assets/process/process_qc_packaging.jpg';

interface ProcessItem {
  id: string;
  name: string;
  category: string;
  subtitle: string;
  image: ImageMetadata;
}

const trendingItems: ProcessItem[] = [
  {
    id: '1',
    name: 'Fabric Cutting',
    category: 'Step 01',
    subtitle: 'High Precision Fit',
    image: fabricCuttingImg
  },
  {
    id: '2',
    name: 'Embroidery & Print',
    category: 'Step 02',
    subtitle: 'Vibrant & Sharp Details',
    image: embroideryImg
  },
  {
    id: '3',
    name: 'Precision Sewing',
    category: 'Step 03',
    subtitle: 'Expert Craftsman Stitching',
    image: sewingImg
  },
  {
    id: '4',
    name: 'Sewing & QC Packaging',
    category: 'Step 04',
    subtitle: '100% Quality Inspection',
    image: qcPackagingImg
  }
];
---

<div class="my-20 lg:my-28 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    {/* Left Column - Typography & CTA */}
    <div class="lg:col-span-4 flex flex-col items-start z-10 text-left">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 text-orange-600 text-[11px] font-bold tracking-wider uppercase mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#FF5A1F]"></span>
        Our Expertise
      </span>

      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-gray-900 mb-6 leading-[1.08] uppercase">
        Production <br/>
        <span class="text-gray-400 font-light italic">Process</span>
      </h2>

      <p class="text-gray-500 max-w-sm leading-relaxed mb-8 text-sm sm:text-base font-normal">
        กระบวนการผลิตที่ได้มาตรฐานระดับสากล ใส่ใจทุกรายละเอียดตั้งแต่การเลือกผ้าจนถึงการตัดเย็บและการบรรจุ
      </p>

      <a href="/services/#process" class="inline-flex items-center gap-2 rounded-full bg-[#FF5A1F] hover:bg-[#E04E17] text-white font-bold px-7 py-3 text-sm shadow-md shadow-orange-600/15 transition-all duration-300 hover:scale-[1.03]">
        <span>Learn More</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    {/* Right Column - Auto-scrolling Marquee */}
    <div class="lg:col-span-8 marquee group/marquee">
      <div class="marquee-track flex gap-5 py-4">
        {[...trendingItems, ...trendingItems].map((item, i) => (
          <div
            class="shrink-0 w-[250px] sm:w-[290px] bg-white rounded-[28px] p-4 shadow-xl shadow-black/5 border border-black/5 group cursor-pointer hover:shadow-2xl hover:scale-[1.02] transition-all duration-500 flex flex-col"
            aria-hidden={i >= trendingItems.length ? 'true' : undefined}
          >
            <div class="w-full aspect-[3/4] rounded-[20px] overflow-hidden bg-gray-100 mb-4 relative">
              <Image src={item.image} alt={item.name} widths={[240, 280, 480, 560]} sizes="(min-width: 640px) 280px, 240px" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />

              {/* Hover Badge */}
              <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-md rounded-full p-2.5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 shadow-md text-gray-900">
                 <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
              </div>
            </div>
            <div class="flex flex-col gap-1.5 px-2 text-left pb-1">
              <span class="inline-self-start px-2.5 py-0.5 rounded-full bg-orange-500/10 text-orange-600 text-[10px] font-extrabold tracking-wider uppercase w-fit">
                {item.category}
              </span>
              <h3 class="text-lg font-bold text-gray-900 truncate mt-0.5">{item.name}</h3>
              <p class="text-xs text-gray-400 font-semibold">{item.subtitle}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    
  </div>
</div>

<style>
  /* Marquee: ตัดส่วนที่ล้นออก + เฟดขอบซ้าย/ขวาให้ดูนุ่ม */
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 5%,
      #000 95%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 5%,
      #000 95%,
      transparent 100%
    );
  }

  /* เลื่อนไป -50% = ความกว้างของชุดแรกพอดี ∴ ลูปต่อเนื่องไร้รอยต่อ */
  .marquee-track {
    width: max-content;
    animation: marquee-scroll 40s linear infinite;
  }

  /* หยุดเมื่อ hover เพื่อให้ผู้ใช้ดูสินค้าได้ */
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* เคารพผู้ใช้ที่ลดการเคลื่อนไหว: ไม่เลื่อนอัตโนมัติ */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee-track {
      animation: none;
    }
  }
</style>

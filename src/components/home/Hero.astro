---
import { Image } from 'astro:assets';
import heroImg from '@/assets/home/hero-faceless-new.jpg';
---

{/* Hero Container - Apple Signature Style */}
<div class="relative w-full mb-12 lg:mb-16">
  
  {/* Cinematic Rounded Widescreen Feature Block */}
  <div class="relative w-full overflow-hidden bg-[#0B0B0D] rounded-[28px] sm:rounded-[32px] min-h-[640px] md:min-h-[760px] lg:min-h-[840px] flex items-center pt-24 pb-12 px-6 sm:px-12 lg:px-16 shadow-2xl border border-white/10">
    {/* Soft Apple-style Ambient Aura Lighting */}
    <div class="absolute top-1/4 left-1/4 w-[400px] h-[400px] rounded-full bg-[#FF5A1F]/15 blur-[140px] pointer-events-none z-0"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[450px] h-[450px] rounded-full bg-amber-500/10 blur-[160px] pointer-events-none z-0"></div>
    
    {/* Absolute background image with smooth gradient overlay */}
    <div class="absolute inset-0 bg-gradient-to-r from-[#0B0B0D] via-[#0B0B0D]/85 via-45% to-transparent z-10 pointer-events-none"></div>
    <Image
      src={heroImg}
      alt="โรงงานทอปกเสื้อและผลิตเสื้อโปโลครบวงจร ธน พลัส 153"
      widths={[480, 768, 1200, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover object-right md:object-center opacity-65 md:opacity-80 z-0 select-none pointer-events-none transition-transform duration-1000 ease-out scale-[1.01]"
    />

    {/* Left Content Column - Apple Typography */}
    <div class="relative z-20 max-w-2xl text-left flex flex-col items-start">
      <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black tracking-tight text-white mb-6 leading-[1.08] uppercase reveal-up delay-100">
        <span class="text-gradient">Innovative Polo</span> <br/>
        & Uniform Solutions
      </h1>

      <p class="text-gray-300 text-sm sm:text-base md:text-lg max-w-xl leading-relaxed mb-10 font-normal reveal-up delay-200">
        เราคือโรงงานผลิตเสื้อโปโลพนักงานและยูนิฟอร์มองค์กรแบบครบวงจร ทอปกเสื้อ ตัดเย็บ ปักคอมพิวเตอร์ และสกรีนลายเสื้อด้วยมาตรฐานคุณภาพสูงและราคาตรงจากโรงงาน
      </p>

      {/* Action Buttons - Apple Pill Style */}
      <div class="flex flex-wrap items-center gap-4 reveal-up delay-300">
        <a
          href="/products/polo-classic/"
          class="inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-[#FF5A1F] to-[#FF8A00] hover:from-[#E04E17] hover:to-[#FF5A1F] text-white font-black px-8 py-3.5 rounded-full shadow-lg shadow-orange-600/20 hover:scale-[1.03] transition-all duration-300 text-sm sm:text-base pulse-glow"
        >
          <span>✨ Customize Your Own Polo</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a
          href="/services/#contact"
          class="inline-flex items-center justify-center gap-2.5 bg-white/10 hover:bg-white/20 text-white font-bold px-8 py-3.5 rounded-full backdrop-blur-md border border-white/20 hover:scale-[1.03] transition-all duration-300 text-sm sm:text-base"
        >
          <span>Contact Us</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    {/* Floating Glass Mockup Card - Apple Glassmorphism */}
    <div class="absolute bottom-10 right-10 bg-white/80 dark:bg-slate-900/80 backdrop-blur-2xl rounded-2xl p-6 shadow-2xl border border-white/30 dark:border-white/10 max-w-[300px] hidden md:flex flex-col items-start text-left z-20 pointer-events-auto transform hover:scale-[1.02] transition-transform reveal-scale delay-500">
      <div class="flex items-center justify-between w-full mb-3 text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">
        <span>01 / Manufacturing</span>
        <span class="text-xs font-black text-gray-900 dark:text-white">QPC Standard</span>
      </div>
      <h3 class="text-sm font-bold text-gray-900 dark:text-white leading-snug mb-4">
        Customized uniform & embroidery solutions.
      </h3>
      <a href="/products/" class="flex items-center gap-1.5 text-xs font-bold text-[#FF5A1F] hover:text-[#E04E17] transition-colors">
        <span>What We Need</span>
        <div class="w-5 h-5 rounded-full bg-[#FF5A1F] text-white flex items-center justify-center text-[10px]">
          <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
      </a>
    </div>

  </div>

  {/* Apple Bento Style Stats Panel */}
  <div class="w-full bg-white dark:bg-slate-900 mt-4 rounded-3xl py-8 px-6 sm:px-10 border border-black/5 dark:border-white/10 shadow-sm relative z-10 reveal-up delay-400">
    <div class="max-w-[1100px] mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6 divide-y md:divide-y-0 md:divide-x divide-gray-200/60 dark:divide-slate-800">
      
      {/* Stat 1 */}
      <div class="flex flex-col items-center md:items-start md:pl-4 text-center md:text-left">
        <span class="text-3xl lg:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight"><span class="counter-number" data-target="10">0</span>+ ปี</span>
        <span class="text-xs text-gray-500 dark:text-gray-400 font-semibold uppercase tracking-wider mt-1.5">ประสบการณ์ผลิตทอและตัดเย็บ</span>
      </div>

      {/* Stat 2 */}
      <div class="flex flex-col items-center md:items-start md:pl-8 text-center md:text-left pt-6 md:pt-0">
        <span class="text-3xl lg:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight"><span class="counter-number" data-target="500">0</span>+ แบรนด์</span>
        <span class="text-xs text-gray-500 dark:text-gray-400 font-semibold uppercase tracking-wider mt-1.5">ที่ไว้วางใจผลิตเสื้อกับเรา</span>
      </div>

      {/* Stat 3 */}
      <div class="flex flex-col items-center md:items-start md:pl-8 text-center md:text-left pt-6 md:pt-0">
        <span class="text-3xl lg:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight"><span class="counter-number" data-target="100">0</span>% QC</span>
        <span class="text-xs text-gray-500 dark:text-gray-400 font-semibold uppercase tracking-wider mt-1.5">ตรวจเช็คกระดุม ตะเข็บ ฝีเข็ม</span>
      </div>

    </div>
  </div>

</div>

<script>
  function initStatsCounters() {
    const counters = document.querySelectorAll('.counter-number');
    const speed = 1200; // speed duration in ms

    const runCounter = (el: HTMLElement) => {
      const target = parseInt(el.getAttribute('data-target') || '0', 10);
      let count = 0;
      const stepTime = Math.max(Math.floor(speed / target), 12);
      
      const timer = setInterval(() => {
        if (target <= 20) {
          count += 1;
        } else {
          count += Math.ceil(target / 80);
        }
        
        if (count >= target) {
          el.innerText = target.toString();
          clearInterval(timer);
        } else {
          el.innerText = count.toString();
        }
      }, stepTime);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          runCounter(el);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.1 });

    counters.forEach(c => observer.observe(c));
  }

  // Astro page loads
  document.addEventListener('astro:page-load', initStatsCounters);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStatsCounters);
  } else {
    initStatsCounters();
  }
</script>
